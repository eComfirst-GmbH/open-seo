# Copy to repo root as .env on the server (/opt/openseo/.env)
# Used with: docker compose -f compose.yaml -f deploy/ecomfirst/compose.ecomfirst.yaml up -d

PORT=3001
ALLOWED_HOST=seo.ecomfirst.de
AUTH_MODE=local_noauth
OPENSEO_TELEMETRY_DISABLED=1

# Required – https://dataforseo.com
DATAFORSEO_API_KEY=

# Optional – SAM agent
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Optional – pull latest upstream image explicitly
# OPEN_SEO_IMAGE=ghcr.io/every-app/open-seo:latest
