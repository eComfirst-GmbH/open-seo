# /etc/nginx-rc/conf.d/seo.ecomfirst.conf (Vorlage – nach DNS + certbot aktivieren)
# Proxy zu OpenSEO Docker auf 127.0.0.1:3001 (siehe deploy/ecomfirst/compose.ecomfirst.yaml)

server {
    listen 80;
    server_name seo.ecomfirst.de;
    charset utf-8;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name seo.ecomfirst.de;
    charset utf-8;

    # ssl_certificate /etc/letsencrypt/live/seo.ecomfirst.de/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/seo.ecomfirst.de/privkey.pem;

    # Option B: Basic Auth (htpasswd -c /etc/nginx-rc/.htpasswd-seo openseo)
    # auth_basic "OpenSEO";
    # auth_basic_user_file /etc/nginx-rc/.htpasswd-seo;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
